CREATE GRAPH CapMarkets()
CREATE SCHEMA_CHANGE JOB schema_change_job_CapMarkets FOR GRAPH CapMarkets { 
  ADD VERTEX Document(PRIMARY_ID id STRING) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true";
  ADD VERTEX Chunk(PRIMARY_ID id STRING, content STRING) WITH STATS="OUTDEGREE_BY_EDGETYPE";
  ADD VERTEX Entity(PRIMARY_ID id STRING, cat STRING) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true";
  ADD VERTEX Event(PRIMARY_ID id STRING, cat STRING) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true";
  ADD UNDIRECTED EDGE Has_Child(FROM Document, TO Chunk);
  ADD UNDIRECTED EDGE Contains_Entity(FROM Chunk, TO Entity);
  ADD UNDIRECTED EDGE Contains_Event(FROM Chunk, TO Event);
  ADD DIRECTED EDGE Has_Action(FROM Entity, TO Event, DISCRIMINATOR( action STRING)) WITH REVERSE_EDGE="reverse_Has_Action";
}
RUN SCHEMA_CHANGE JOB schema_change_job_CapMarkets